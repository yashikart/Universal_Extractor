# Copy to .env and fill in your keys:
#   copy .env.example .env

# Official-site search (Tavily — preferred over DuckDuckGo)
TAVILY_API_KEY=tvly-your-key-here

# Optional: LLM extraction on real event websites (not Conference Index listings)
OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# When Tavily is set, also search for official sites for Conference Index / aggregator URLs.
# Set to false to keep listing+program only for CI events.
ENABLE_CI_OFFICIAL_SEARCH=true
